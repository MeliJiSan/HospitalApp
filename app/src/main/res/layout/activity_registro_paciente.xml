
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
    <TextView android:id="@+id/tvTitulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Registrar Paciente" android:textSize="20sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <EditText android:id="@+id/etNombrePaciente" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="Nombre completo" android:layout_marginTop="12dp" app:layout_constraintWidth_percent="0.9" app:layout_constraintTop_toBottomOf="@id/tvTitulo" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <EditText android:id="@+id/etEdadPaciente" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="Edad" android:inputType="number" android:layout_marginTop="8dp" app:layout_constraintWidth_percent="0.9" app:layout_constraintTop_toBottomOf="@id/etNombrePaciente" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/tvLabelDoctor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Doctor asignado:" android:layout_marginTop="12dp" app:layout_constraintTop_toBottomOf="@id/etEdadPaciente" app:layout_constraintStart_toStartOf="parent"/>
    <!--  Spinner con los doctores reales de la BD (antes el doctor quedaba fijo en id=1)  -->
    <Spinner android:id="@+id/spinnerDoctor" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" app:layout_constraintWidth_percent="0.9" app:layout_constraintTop_toBottomOf="@id/tvLabelDoctor" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  Contenedor para instanciar el Fragment de Consulta  -->
    <FrameLayout android:id="@+id/fragmentContainer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:layout_constraintWidth_percent="0.9" app:layout_constraintTop_toBottomOf="@id/spinnerDoctor" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <Button android:id="@+id/btnGuardarTodo" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Guardar Paciente y Consulta" android:layout_marginTop="16dp" app:layout_constraintWidth_percent="0.9" app:layout_constraintTop_toBottomOf="@id/fragmentContainer" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>